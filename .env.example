NODE_ENV=development
PORT=3000
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bpn_booking
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_TIMEZONE=+08:00
DB_CONNECT_TIMEOUT_MS=8000
DB_QUERY_TIMEOUT_MS=8000
DB_QUEUE_LIMIT=100
# Clever Cloud Free memiliki batas koneksi kecil.
DB_CONNECTION_LIMIT=2

# Alternatif untuk database Clever Cloud.
# Jika variabel MYSQL_ADDON_* diisi, aplikasi akan memakainya lebih dulu
# daripada DB_HOST/DB_USER/DB_PASSWORD/DB_NAME.
MYSQL_ADDON_HOST=
MYSQL_ADDON_DB=
MYSQL_ADDON_USER=
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_PASSWORD=
MYSQL_ADDON_URI=

# Alternatif untuk Railway MySQL.
MYSQL_URL=
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

JWT_SECRET=ganti_dengan_secret_minimal_32_karakter
JWT_EXPIRES_IN=1d

# Pisahkan dengan koma jika lebih dari satu domain.
# Kosongkan saat development lokal agar semua origin lokal tetap bisa dipakai.
CORS_ORIGINS=

# Rate limit login/register
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# OTP email verification dan lupa sandi
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Data registrasi yang belum selesai dipertahankan agar dapat dilanjutkan.
PENDING_REGISTRATION_RETENTION_DAYS=30
# Setelah lewat batas ini, email harus diverifikasi ulang sebelum melengkapi profil.
PROFILE_COMPLETION_TRUST_HOURS=24
REGISTRATION_COMPLETION_EXPIRES_IN=30m

# Upload hasil pemeriksaan: default 3 MB, hanya JPG/PNG/WEBP.
UPLOAD_MAX_BYTES=3145728

# Provider email:
# - smtp: cocok untuk lokal atau hosting yang mengizinkan koneksi SMTP.
# - resend: gunakan HTTPS API; direkomendasikan untuk Railway Free/Trial/Hobby.
# Jika EMAIL_PROVIDER kosong tetapi RESEND_API_KEY terisi, provider Resend dipilih otomatis.
EMAIL_PROVIDER=smtp

# Resend HTTPS API untuk deployment Railway.
# Setelah domain pengirim diverifikasi di Resend, gunakan contoh:
# EMAIL_FROM=BPN Luwu Timur <noreply@domain-anda.go.id>
RESEND_API_KEY=
EMAIL_FROM=

# Gmail SMTP untuk development lokal atau hosting yang mengizinkan SMTP.
# Gunakan Google App Password 16 karakter, bukan password login Gmail biasa.
# App Password biasanya terlihat seperti "abcd efgh ijkl mnop"; boleh ditulis dengan spasi atau tanpa spasi.
EMAIL_USER=sistembpnlutim@gmail.com
EMAIL_PASS=app_password_16_karakter
EMAIL_SERVICE=gmail

# Opsional: alamat tujuan untuk npm run test:email
EMAIL_TEST_TO=email_tujuan_untuk_tes@example.com

# Opsional: aktifkan log sukses pengiriman email
EMAIL_DEBUG=false

# Opsional: jumlah email background yang boleh dikirim bersamaan
EMAIL_QUEUE_CONCURRENCY=2

# Batas waktu koneksi SMTP/Resend (ms). Dibuat lebih pendek dari timeout frontend.
EMAIL_TIMEOUT_MS=8000

# Reminder email petugas untuk jadwal H-1 dan hari-H.
# Jika tidak diatur, otomatis aktif saat NODE_ENV=production dan nonaktif saat development.
PETUGAS_REMINDER_ENABLED=false
PETUGAS_REMINDER_INTERVAL_MINUTES=15
PETUGAS_REMINDER_START_HOUR_WITA=7
PETUGAS_REMINDER_INITIAL_DELAY_MS=15000
PETUGAS_REMINDER_MAX_ATTEMPTS=3
PETUGAS_REMINDER_RETRY_MINUTES=15

# Opsional: log API jika lebih lambat dari nilai ini (ms)
SLOW_REQUEST_MS=5000
